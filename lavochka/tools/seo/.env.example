# Скопировать в .env рядом (lavochka/tools/seo/.env) и подставить свои значения.
# API-ключ сервисного аккаунта Yandex Cloud с ролью search-api.webSearch.user
# (область ключа — yc.search-api.execute)
YANDEX_SEARCH_API_KEY=
# ID каталога (folder) этого сервисного аккаунта, вида b1g...
YANDEX_FOLDER_ID=
