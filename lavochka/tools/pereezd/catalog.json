  "base": [
    {
      "id": "nvidia",
      "name": "Драйвер NVIDIA (Studio или Game Ready)",
      "why": "без него видеокарты не работают для ИИ",
      "page": "https://www.nvidia.com/ru-ru/drivers/",
      "auto": null,
      "manual": "Скачать на странице (или через NVIDIA App), установить, перезагрузить компьютер."
    },
    {
      "id": "vcredist",
      "name": "Microsoft Visual C++ Redistributable",
      "why": "нужен llama.cpp, PyTorch и многим программам",
      "page": "https://learn.microsoft.com/cpp/windows/latest-supported-vc-redist",
      "auto": {
        "kind": "exe",
        "url": "https://aka.ms/vs/17/release/vc_redist.x64.exe",
        "args": [
          "/install",
          "/passive",
          "/norestart"
        ]
      }
    },
    {
      "id": "git",
      "name": "Git для Windows (с Git LFS)",
      "why": "забрать код с GitHub; LFS — тяжёлые ассеты",
      "page": "https://git-scm.com/download/win",
      "auto": {
        "kind": "gh",
        "repo": "git-for-windows/git",
        "asset": "^Git-[\\d.]+-64-bit\\.exe$",
        "args": [
          "/VERYSILENT",
          "/NORESTART",
          "/SP-"
        ]
      },
      "check": [
        "git",
        "--version"
      ]
    },
    {
      "id": "node",
      "name": "Node.js 24",
      "why": "сборник (Vite, тесты, сервер); хуки Claude ждут его в C:\\Program Files\\nodejs",
      "page": "https://nodejs.org/dist/latest-v24.x/",
      "auto": {
        "kind": "node_msi",
        "index": "https://nodejs.org/dist/latest-v24.x/SHASUMS256.txt",
        "base": "https://nodejs.org/dist/latest-v24.x/",
        "pattern": "node-v24\\.[\\d.]+-x64\\.msi"
      },
      "check": [
        "node",
        "-v"
      ]
    },
    {
      "id": "python",
      "name": "Python 3.12",
      "why": "инструменты сборника, ComfyUI, аудио-модели (3.12 — самая совместимая с PyTorch)",
      "page": "https://www.python.org/downloads/release/python-31210/",
      "auto": {
        "kind": "exe",
        "url": "https://www.python.org/ftp/python/3.12.10/python-3.12.10-amd64.exe",
        "args": [
          "/passive",
          "InstallAllUsers=0",
          "PrependPath=1",
          "Include_launcher=1",
          "Include_test=0"
        ]
      },
      "check": [
        "py",
        "-3.12",
        "--version"
      ]
    },
    {
      "id": "chrome",
      "name": "Google Chrome",
      "why": "безголовые снимки превью игр",
      "page": "https://www.google.com/chrome/",
      "auto": {
        "kind": "exe",
        "url": "https://dl.google.com/chrome/install/latest/chrome_installer.exe",
        "args": [
          "/silent",
          "/install"
        ]
      }
    },
    {
      "id": "claude",
      "name": "Claude (приложение)",
      "why": "работа с Claude Code в папке проекта",
