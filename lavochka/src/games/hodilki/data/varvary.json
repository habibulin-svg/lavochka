{"w":6000,"h":4489,"end":239,"cells":[{"x":646,"y":1564,"l":"1"},{"x":796,"y":1564,"l":"2"},{"x":951,"y":1564,"l":"3"},{"x":1132,"y":1564,"l":"4"},{"x":2307,"y":1550,"l":"5","s":"to:0","t":"Язон в кибитке едет в гости к Темучину под видом шамана-колдуна."},{"x":2494,"y":1550,"l":"6"},{"x":2674,"y":1564,"l":"7"},{"x":3682,"y":1931,"l":"8","s":"to:15","t":"Темучин замыслил отправиться в загадочный мир низины, где, по слухам, местные жители умеют делать порох. Язона Темучин не узнал и взял с собой."},{"x":3517,"y":1957,"l":"9"},{"x":3362,"y":1957,"l":"10"},{"x":3207,"y":1957,"l":"11"},{"x":3062,"y":1957,"l":"12"},{"x":2907,"y":1957,"l":"13"},{"x":2752,"y":1988,"l":"14"},{"x":2752,"y":2132,"l":"15"},{"x":2907,"y":2168,"l":"16"},{"x":3068,"y":2163,"l":"17"},{"x":3217,"y":2168,"l":"18"},{"x":3367,"y":2168,"l":"19"},{"x":3522,"y":2168,"l":"20"},{"x":3713,"y":2163,"l":"21","s":"to:26","t":"Чтобы попасть в страну низины, надо было спуститься с колоссального обрыва, так как народ Темучина жил на огромном суровом горном плато. Язон одним из первых стал спускаться в пропасть."},{"x":3909,"y":2168,"l":"22"},{"x":4088,"y":3076,"l":"23"},{"x":4083,"y":3232,"l":"24"},{"x":4083,"y":3366,"l":"25"},{"x":4089,"y":3521,"l":"26"},{"x":4104,"y":3686,"l":"27"},{"x":4223,"y":3769,"l":"28","s":"to:21","t":"Потом канат подъёмной машины пополз вверх: надо было опустить ещё десять человек и десять маронов (животных, похожих на лошадей)."},{"x":4393,"y":3785,"l":"29"},{"x":4563,"y":3785,"l":"30"},{"x":4734,"y":3785,"l":"31"},{"x":4941,"y":3785,"l":"32"},{"x":5313,"y":3924,"l":"33"},{"x":5189,"y":3950,"l":"34"},{"x":5044,"y":3950,"l":"35"},{"x":4156,"y":3961,"l":"36"},{"x":4089,"y":4084,"l":"37","s":"skip","t":"Отряд воинов очутился в стране лесов и трав. Через сутки отряд подошёл к небольшому форту, охраняемому маленьким гарнизоном солдат. Завязался бой. Победа досталась людям Темучина, и главное — он получил порох."},{"x":4171,"y":4214,"l":"38"},{"x":5059,"y":4214,"l":"39"},{"x":5199,"y":4214,"l":"40"},{"x":5343,"y":4193,"l":"41"},{"x":5494,"y":4100,"l":"42","s":"to:32","t":"На обратном пути отряд вышел к реке. Переходя вброд реку, люди сбились с дороги."},{"x":5576,"y":3955,"l":"43"},{"x":4951,"y":3505,"l":"44"},{"x":4796,"y":3505,"l":"45"},{"x":4631,"y":3505,"l":"46"},{"x":4460,"y":3511,"l":"47","s":"to:53","t":"После долгих блужданий по лесу отряд вышел к подножию плато. После краткого отдыха люди стали подниматься вверх."},{"x":4409,"y":2926,"l":"48"},{"x":4357,"y":2340,"l":"49"},{"x":4305,"y":1755,"l":"50"},{"x":4315,"y":1595,"l":"51"},{"x":4310,"y":1467,"l":"52"},{"x":4274,"y":1302,"l":"53"},{"x":4166,"y":1188,"l":"54"},{"x":3992,"y":1189,"l":"55","s":"to:47","t":"Ещё не раз ременная петля подземной машины скользила вверх и вниз, пока последний солдат не ступил на край горного плато."},{"x":3842,"y":1189,"l":"56"},{"x":3682,"y":1189,"l":"57"},{"x":3532,"y":1189,"l":"58"},{"x":3367,"y":1189,"l":"59"},{"x":3212,"y":1189,"l":"60"},{"x":3036,"y":1189,"l":"61"},{"x":2860,"y":1189,"l":"62"},{"x":2674,"y":1189,"l":"63"},{"x":2483,"y":1189,"l":"64","s":"skip","t":"Люди были так измучены дорогой, что Темучину пришлось разбить бивак."},{"x":2307,"y":1189,"l":"65"},{"x":2158,"y":1189,"l":"66"},{"x":1984,"y":1189,"l":"67"},{"x":1850,"y":1189,"l":"68"},{"x":1671,"y":1189,"l":"69"},{"x":1493,"y":1189,"l":"70"},{"x":1318,"y":1194,"l":"71"},{"x":1178,"y":1240,"l":"72"},{"x":1065,"y":1333,"l":"73"},{"x":997,"y":1468,"l":"74"},{"x":1008,"y":1699,"l":"75","s":"skip","t":"Наконец-то лагерь. Здесь можно отдохнуть как следует."},{"x":1075,"y":1817,"l":"76"},{"x":1173,"y":1890,"l":"77"},{"x":1313,"y":1947,"l":"78"},{"x":1493,"y":1947,"l":"79"},{"x":1663,"y":1952,"l":"80"},{"x":1845,"y":1952,"l":"81"},{"x":2010,"y":1952,"l":"82"},{"x":2168,"y":1946,"l":"83"},{"x":2318,"y":1957,"l":"84"},{"x":2473,"y":1967,"l":"85"},{"x":2587,"y":2081,"l":"86"},{"x":2602,"y":2251,"l":"87"},{"x":2602,"y":2380,"l":"88"},{"x":2587,"y":2515,"l":"89"},{"x":2602,"y":2659,"l":"90"},{"x":2602,"y":2815,"l":"91","s":"route:240,241,242,243,244,245,246,247,248,249,250,251,89","r":"идёт кружным путём через ущелье","t":"На следующий день Темучин, горя желанием опробовать порох в деле, трубит новый сбор. Цель — независимое племя за горной грядой. Язон предлагает пойти кружным путём, через горное ущелье. С 91 на 90, последовательно по клеткам."},{"x":2618,"y":2990,"l":"92"},{"x":2602,"y":3144,"l":"93"},{"x":2622,"y":3306,"l":"94"},{"x":2752,"y":3299,"l":"95","s":"to:101","t":"Племя укрылось за неприступным горным валом. Язон решил залезть на скалы, чтобы осмотреть укрепления противника."},{"x":2793,"y":3170,"l":"96"},{"x":2752,"y":2990,"l":"97"},{"x":2793,"y":2815,"l":"98"},{"x":2825,"y":2680,"l":"99"},{"x":2897,"y":2545,"l":"100"},{"x":3005,"y":2453,"l":"101"},{"x":3155,"y":2396,"l":"102"},{"x":3310,"y":2370,"l":"103","s":"to:95","t":"Герой спускается вниз, чтобы взять самодельные пороховые гранаты, с помощью которых он решил взорвать каменный завал."},{"x":3460,"y":2396,"l":"104"},{"x":3620,"y":2458,"l":"105"},{"x":3760,"y":2577,"l":"106","s":"to:110","t":"После удачного взрыва каменной баррикады войска Темучина ринулись в бой. Язон стал спускаться со скалы."},{"x":3827,"y":2706,"l":"107"},{"x":3857,"y":2866,"l":"108"},{"x":3868,"y":2990,"l":"109"},{"x":3868,"y":3144,"l":"110"},{"x":3868,"y":3299,"l":"111"},{"x":3796,"y":3449,"l":"112"},{"x":3661,"y":3521,"l":"113"},{"x":3537,"y":3521,"l":"114"},{"x":3326,"y":3521,"l":"115"},{"x":3155,"y":3521,"l":"116"},{"x":2985,"y":3521,"l":"117"},{"x":2824,"y":3521,"l":"118"},{"x":2659,"y":3521,"l":"119"},{"x":2493,"y":3521,"l":"120","s":"skip","t":"Битва разыгралась не шуточная. Атака шла за атакой."},{"x":899,"y":3485,"l":"121"},{"x":827,"y":3309,"l":"122"},{"x":827,"y":3144,"l":"123"},{"x":827,"y":2969,"l":"124"},{"x":827,"y":2804,"l":"125"},{"x":827,"y":2649,"l":"126"},{"x":827,"y":2504,"l":"127"},{"x":827,"y":2349,"l":"128"},{"x":817,"y":2173,"l":"129"},{"x":817,"y":2024,"l":"130"},{"x":832,"y":1885,"l":"131"},{"x":821,"y":1699,"l":"132"},{"x":817,"y":1447,"l":"133","s":"skip","t":"В конце концов противник пал, и Темучин стал полновластным повелителем здешнего мира. Войска повернули назад. Впереди всех ожидал отдых."},{"x":827,"y":1307,"l":"134"},{"x":744,"y":1178,"l":"135"},{"x":651,"y":1178,"l":"136"},{"x":604,"y":1281,"l":"137"},{"x":604,"y":1447,"l":"138"},{"x":609,"y":1699,"l":"139","s":"skip2","t":"Несмотря на то, что Язон неоднократно помогал Темучину, тот подозревал его. На другой день Язона схватили солдаты и бросили по приказу Темучина в темницу."},{"x":599,"y":2494,"l":"140"},{"x":610,"y":2639,"l":"141","s":"to:144","t":"Через двое суток, решив убрать Язона, Темучин приказал бросить его в пропасть, объявив предателем."},{"x":599,"y":2804,"l":"142"},{"x":610,"y":3542,"l":"143"},{"x":599,"y":3707,"l":"144"},{"x":672,"y":3831,"l":"145"},{"x":832,"y":3893,"l":"146"},{"x":1008,"y":3893,"l":"147"},{"x":1173,"y":3893,"l":"148"},{"x":1343,"y":3893,"l":"149"},{"x":1498,"y":3893,"l":"150"},{"x":1669,"y":3893,"l":"151","s":"to:156"},{"x":1839,"y":3893,"l":"152"},{"x":1989,"y":3893,"l":"153"},{"x":2091,"y":3965,"l":"154"},{"x":1989,"y":4064,"l":"155"},{"x":1834,"y":4064,"l":"156"},{"x":1663,"y":4064,"l":"157"},{"x":1498,"y":4064,"l":"158"},{"x":1343,"y":4064,"l":"159","s":"to:148"},{"x":1178,"y":4064,"l":"160","s":"to:169"},{"x":1018,"y":4064,"l":"161"},{"x":847,"y":4064,"l":"162","s":"to:145"},{"x":666,"y":4064,"l":"163","s":"to:166"},{"x":501,"y":4064,"l":"164"},{"x":372,"y":4151,"l":"165"},{"x":501,"y":4224,"l":"166"},{"x":666,"y":4224,"l":"167"},{"x":847,"y":4224,"l":"168"},{"x":1018,"y":4224,"l":"169","s":"to:160"},{"x":1178,"y":4224,"l":"170"},{"x":1348,"y":4224,"l":"171"},{"x":1498,"y":4224,"l":"172"},{"x":1674,"y":4224,"l":"173"},{"x":1834,"y":4224,"l":"174","s":"to:155"},{"x":1995,"y":4224,"l":"175"},{"x":2189,"y":4229,"l":"176"},{"x":2364,"y":4226,"l":"177"},{"x":2540,"y":4226,"l":"178"},{"x":2679,"y":4226,"l":"179"},{"x":3537,"y":4226,"l":"180","s":"to:186","t":"Герой набрёл на подземную реку и бросился в воду."},{"x":3646,"y":4193,"l":"181"},{"x":3775,"y":4079,"l":"182"},{"x":3914,"y":3955,"l":"183"},{"x":4068,"y":3790,"l":"184"},{"x":4218,"y":3645,"l":"185"},{"x":4326,"y":3542,"l":"186"},{"x":4450,"y":3407,"l":"187"},{"x":5034,"y":3180,"l":"188","s":"skip","t":"Силы были на исходе."},{"x":5189,"y":3180,"l":"189"},{"x":5349,"y":3180,"l":"190"},{"x":5504,"y":3180,"l":"191"},{"x":5607,"y":3098,"l":"192"},{"x":5489,"y":3000,"l":"193"},{"x":5333,"y":3000,"l":"194"},{"x":5183,"y":3000,"l":"195"},{"x":5070,"y":2959,"l":"196"},{"x":4982,"y":2825,"l":"197"},{"x":4987,"y":2680,"l":"198","s":"to:191","t":"После долгих блужданий Язон набрёл на космический катер-разведчик. Браслет-радиомаячок при падении разбился."},{"x":4987,"y":2515,"l":"199"},{"x":4987,"y":2370,"l":"200"},{"x":4987,"y":2225,"l":"201","s":"to:208","t":"Язон вполз в катер, где его подхватила Джейн. Катер стартовал и повёл к кораблю на планетарной орбите."},{"x":4987,"y":2081,"l":"202"},{"x":4987,"y":1915,"l":"203"},{"x":4972,"y":1791,"l":"204"},{"x":5064,"y":1539,"l":"205"},{"x":5054,"y":1416,"l":"206"},{"x":5043,"y":1256,"l":"207"},{"x":5329,"y":300,"l":"208"},{"x":5473,"y":388,"l":"209"},{"x":5561,"y":517,"l":"210"},{"x":5566,"y":661,"l":"211"},{"x":5571,"y":827,"l":"212"},{"x":5571,"y":966,"l":"213"},{"x":5566,"y":1116,"l":"214"},{"x":5566,"y":1271,"l":"215","s":"skip","t":"Целый день Язон провёл в библиотеке корабля. Ещё день Керк и Джейн убеждали его, что надо вернуться в лагерь Темучина и больше не воевать с туземцами."},{"x":5034,"y":1760,"l":"216"},{"x":4894,"y":1585,"l":"217"},{"x":4760,"y":1457,"l":"218"},{"x":4620,"y":1333,"l":"219"},{"x":4502,"y":1219,"l":"220","s":"to:226","t":"Язон на катере опускается на планету и отправляется в лагерь Темучина."},{"x":4388,"y":1100,"l":"221"},{"x":4274,"y":992,"l":"222"},{"x":4171,"y":878,"l":"223"},{"x":4026,"y":806,"l":"224"},{"x":3847,"y":801,"l":"225"},{"x":3682,"y":801,"l":"226"},{"x":3537,"y":801,"l":"227"},{"x":3372,"y":801,"l":"228"},{"x":3212,"y":801,"l":"229"},{"x":3036,"y":801,"l":"230"},{"x":2865,"y":801,"l":"231"},{"x":2684,"y":801,"l":"232"},{"x":2492,"y":801,"l":"233"},{"x":2316,"y":801,"l":"234"},{"x":2158,"y":801,"l":"235"},{"x":1943,"y":801,"l":"236","s":"skip","t":"Темучин был сильнее, но Язон проворнее. Прошёл почти час, пока Язон ловким ударом не поразил врага. Пропустить один ход. Так закончилась эпоха войн, и началась эпоха созидания."},{"x":636,"y":801,"l":"237"},{"x":506,"y":817,"l":"238"},{"x":398,"y":909,"l":"239"},{"x":367,"y":1069,"l":"240"},{"x":2403,"y":3130,"off":1},{"x":2232,"y":3239,"off":1},{"x":2075,"y":3278,"off":1},{"x":1860,"y":3257,"off":1},{"x":1705,"y":3190,"off":1},{"x":1596,"y":3097,"off":1},{"x":1550,"y":2339,"off":1},{"x":1691,"y":2225,"off":1},{"x":1875,"y":2147,"off":1},{"x":2059,"y":2139,"off":1},{"x":2259,"y":2178,"off":1},{"x":2389,"y":2296,"off":1,"l":"ущелье"}]}