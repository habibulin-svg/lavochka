{
  "name": "vecherom-na-lavochke",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && tsx tools/prerender.ts && npm run build:server",
    "prerender": "tsx tools/prerender.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/index.js --packages=external",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/three": "^0.170.0",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "svgo": "^3.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "peerjs": "^1.5.4",
    "three": "^0.170.0",
    "topojson-client": "^3.1.0",
    "ws": "^8.22.0"
  }
}
