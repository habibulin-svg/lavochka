{
 "_about": "Апскейл моделью ×4, затем масштаб scale (0.5 — итог ×2).",
 "1": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{image}}"
  }
 },
 "2": {
  "class_type": "UpscaleModelLoader",
  "inputs": {
   "model_name": "{{upscaler}}"
  }
 },
 "3": {
  "class_type": "ImageUpscaleWithModel",
  "inputs": {
   "upscale_model": [
    "2",
    0
   ],
   "image": [
    "1",
    0
   ]
  }
 },
 "4": {
  "class_type": "ImageScaleBy",
  "inputs": {
   "image": [
    "3",
    0
   ],
   "upscale_method": "lanczos",
   "scale_by": "{{scale}}"
  }
 },
 "5": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "4",
    0
   ],
   "filename_prefix": "{{prefix}}"
  }
 }
}